# Client-side (VITE_*) vars are INLINED INTO THE BROWSER BUNDLE by Vite.
# Only ever put the publishable key here — never a secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (no VITE_ prefix). Bypasses RLS — used by one-off
# maintenance scripts such as scripts/recalculate-elo.ts.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
